# .env cho thành viên nhóm: cp .env.team.example .env — xem docs/dev-setup.md.
#
# Secret dùng chung (DB, Redis, MinIO, Qdrant, Neo4j, Canvas token, LTI phía
# Canvas, cấu hình embedding) KHÔNG nằm ở đây: scripts/dc lấy chúng từ
# Infisical lúc chạy. Có điền vào đây thì cũng bị Infisical ghi đè.

# Dùng DB stack chung trên fedoralap qua Tailscale.
COMPOSE_FILE=docker-compose.yml:docker-compose.remote-db.yml

# Port trên máy bạn.
WEB_PORT=3001
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# ── Key model của riêng bạn ──
# Đặt hạn mức chi tiêu ở trang của nhà cung cấp.
# Gemini: model mặc định của hầu hết task (enrichment, kiểm tra câu hỏi, chấm, tutor).
GEMINI_API_KEY=
# DeepSeek: model mặc định của sinh câu hỏi. Không làm phần này thì để trống.
DEEPSEEK_API_KEY=
# Voyage (qua MongoDB Atlas). Model embedding đã cố định trên Infisical vì cả
# nhóm dùng chung một Qdrant; key khác nhau vẫn ra cùng vector.
EMBEDDING_API_KEY=

# ── Tác vụ nền ghi vào DB chung ──
# core-api của MỌI người đều chạy hai việc này trên cùng DB/Canvas, nên mặc
# định tắt ở máy thành viên; chỉ bật khi đang làm đúng phần đó và đã báo nhóm.
# AGS: poller quét quiz_attempts chung và đẩy điểm lên Canvas bằng LTI_CLIENT_ID
# của máy này — sai client id thì Canvas từ chối, lúc khởi động còn thả các
# attempt đang POSTING của người khác về PENDING.
AGS_ENABLED=false
# Đồng bộ tài liệu Canvas mỗi 15 phút và mỗi lần mở tool. Nút đồng bộ thủ
# công vẫn dùng được.
CANVAS_AUTO_SYNC_ENABLED=false

# ── LTI phía tool ──
# Chỉ cần khi muốn launch từ Canvas vào stack trên máy bạn
# (docs/dev-setup.md, mục 5). Để trống thì stack vẫn chạy, chỉ không launch được.
LTI_REDIRECT_URI=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_KEY_ID=ai-nextjs-1

# Tên service nội bộ trong compose, để nguyên.
GRPC_HOST=grpc-server:50051
NEXT_PUBLIC_BACKEND_URL=http://http-api:8000
