# Copy to `.env` on the DA/chunking machine and replace both hosts.
#
# Tailscale DNS name is easier to remember, for example:
#   DA_TAILSCALE_HOST=da-box.tailnet-name.ts.net
#   EDX_TAILSCALE_HOST=edx-box.tailnet-name.ts.net
# Plain Tailscale IP also works.

DA_PUBLIC_URL=http://100.99.64.65:3000
EDX_PUBLIC_URL=http://100.103.17.37

# Next.js LTI tool config
LTI_LMS_TYPE=openedx
LTI_PLATFORM_URL=http://100.103.17.37
LTI_ISSUER_URL=http://100.103.17.37
LTI_AUTH_URL=http://100.103.17.37/oauth2/authorize
LTI_JWKS_URL=http://100.103.17.37/oauth2/jwks
LTI_TOKEN_URL=http://100.103.17.37/oauth2/access_token
LTI_DEPLOYMENT_ID=
LTI_REDIRECT_URI=http://100.99.64.65:3000/lti/launch
LTI_CLIENT_ID=ai-nextjs-1
LTI_KEY_ID=ai-nextjs-1

# Internal DA compose service names. Leave these as-is when running web inside
# this docker-compose project.
GRPC_HOST=grpc-server:50051
NEXT_PUBLIC_BACKEND_URL=http://http-api:8000

# Required by docker-compose.yml for LLM-backed quiz/enrichment flows.
GEMINI_API_KEY=
# Sinh câu hỏi bằng model khác (chỉ content-generation-worker). Ví dụ DeepSeek:
#   QUIZ_LLM_PROVIDER=deepseek
#   QUIZ_LLM_MODEL=deepseek-chat
#   QUIZ_LLM_API_KEY=<khoá DeepSeek>
# QUIZ_LLM_BASE_URL để trống thì DeepSeek dùng https://api.deepseek.com.
QUIZ_LLM_PROVIDER=
QUIZ_LLM_MODEL=
QUIZ_LLM_API_KEY=
QUIZ_LLM_BASE_URL=
