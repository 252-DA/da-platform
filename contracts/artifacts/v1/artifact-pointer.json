{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/artifacts/v1/artifact-pointer.json",
  "title": "ArtifactPointerV1",
  "description": "Pointer tới artifact trên MinIO. SHA-256 tính trên compressed bytes; gzip deterministic (mtime=0). Key immutable: key đã tồn tại phải cùng checksum.",
  "type": "object",
  "properties": {
    "bucket": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compressed_size": { "type": "integer", "minimum": 0, "maximum": 10485760 },
    "uncompressed_size": { "type": "integer", "minimum": 0, "maximum": 52428800 },
    "content_encoding": { "const": "gzip" },
    "media_type": { "const": "application/json" },
    "schema_version": { "type": "integer", "const": 1 }
  },
  "required": [
    "bucket",
    "key",
    "sha256",
    "compressed_size",
    "uncompressed_size",
    "content_encoding",
    "media_type",
    "schema_version"
  ],
  "additionalProperties": false
}
