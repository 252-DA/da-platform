{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/artifacts/v1/document-enrichment.json",
  "title": "DocumentEnrichmentArtifactV1",
  "description": "Artifact document-enrichment. Core chỉ persist card/quiz có lo_id hợp lệ; candidate chưa map LO vẫn nằm trong artifact để audit.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "document_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lo_id": { "type": "string", "format": "uuid" },
          "position": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "key_insight": { "type": "string", "minLength": 1 },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_chunk_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "model_id": { "type": "string", "minLength": 1 }
        },
        "required": ["lo_id", "position", "title", "key_insight", "bullets", "source_chunk_ids", "model_id"],
        "additionalProperties": false
      }
    },
    "quiz_items": {
      "type": "array",
      "items": {
        "$ref": "../v1/content-generation.json#/definitions/quizItem"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["concept_id", "name", "description", "aliases"],
        "additionalProperties": false
      }
    },
    "chunk_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": { "type": "string", "format": "uuid" },
          "concept_id": { "type": "string", "format": "uuid" },
          "mention_count": { "type": "integer", "minimum": 0 },
          "position": { "type": "integer", "minimum": 0 }
        },
        "required": ["chunk_id", "concept_id", "mention_count", "position"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "document_id", "run_id", "revision", "cards", "quiz_items", "concepts", "chunk_concepts"],
  "additionalProperties": false
}
