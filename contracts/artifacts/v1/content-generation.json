{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/artifacts/v1/content-generation.json",
  "title": "ContentGenerationArtifactV1",
  "description": "Artifact content-generation. All-or-nothing: phải chứa đúng tất cả LO trong content_generation_targets; mỗi LO có 1..count_per_lo items.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "format": "uuid" },
    "course_id": { "type": "string", "format": "uuid" },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "lo_id": { "type": "string", "format": "uuid" },
          "lo_code": { "type": "string", "minLength": 1 },
          "bloom_level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "quiz_items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/definitions/quizItem"
            }
          }
        },
        "required": ["lo_id", "lo_code", "bloom_level", "quiz_items"],
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "quizItem": {
      "type": "object",
      "properties": {
        "position": { "type": "integer", "minimum": 0 },
        "question": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "correct_index": { "type": "integer", "minimum": 0, "maximum": 3 },
        "explanation": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "lo_alignment_rationale": { "type": "string", "minLength": 1 },
        "source_chunk_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "model_id": { "type": "string", "minLength": 1 }
      },
      "required": [
        "position",
        "question",
        "choices",
        "correct_index",
        "explanation",
        "difficulty",
        "lo_alignment_rationale",
        "source_chunk_ids",
        "model_id"
      ],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "request_id", "course_id", "results"],
  "additionalProperties": false
}
