{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/artifacts/v1/document-index.json",
  "title": "DocumentIndexArtifactV1",
  "description": "Artifact document-index: toàn bộ chunks của run/revision (snapshot để projection replace).",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "document_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": { "type": "string", "format": "uuid" },
          "chunk_index": { "type": "integer", "minimum": 0 },
          "content": { "type": "string", "minLength": 1 },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "heading_path": {
            "type": "array",
            "items": { "type": "string" }
          },
          "heading_level": { "type": "integer", "minimum": 0 },
          "page_number": { "type": ["integer", "null"], "minimum": 0 },
          "language": { "type": "string", "minLength": 1 }
        },
        "required": [
          "chunk_id",
          "chunk_index",
          "content",
          "content_hash",
          "heading_path",
          "heading_level",
          "page_number",
          "language"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "document_id", "run_id", "revision", "chunks"],
  "additionalProperties": false
}
