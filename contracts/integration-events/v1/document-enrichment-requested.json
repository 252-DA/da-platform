{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/integration-events/v1/document-enrichment-requested.json",
  "title": "DOCUMENT_ENRICHMENT_REQUESTED",
  "description": "AI internal event (AI outbox → queue: document_enrichment). Phát sau DOCUMENT_INDEXED.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.json" }],
  "properties": {
    "event_type": { "const": "DOCUMENT_ENRICHMENT_REQUESTED" },
    "aggregate_type": { "const": "document" },
    "payload": {
      "type": "object",
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "chunk_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["document_id", "run_id", "revision", "chunk_count"],
      "additionalProperties": false
    }
  }
}
