{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/integration-events/v1/definitions.json",
  "title": "Shared definitions for integration events v1",
  "$defs": {
    "errorPayload": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "failed_stage": { "type": "string", "minLength": 1 }
      },
      "required": ["code", "message", "retryable", "failed_stage"],
      "additionalProperties": false
    },
    "failureEnvelope": {
      "type": "object",
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "error": { "$ref": "#/$defs/errorPayload" }
      },
      "required": ["attempt", "error"],
      "additionalProperties": false
    }
  }
}
