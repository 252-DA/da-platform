{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/integration-events/v1/enrichment-content-result.json",
  "title": "ENRICHMENT_CONTENT_RESULT",
  "description": "Học liệu nháp sinh tự động từ một tài liệu (enrichment): worker/use_cases/run_enrichment.py → core-api (core-api/src/modules/content-generation/handlers/enrichment-content-result.handler.ts), hàng đợi worker_results. core-api thay toàn bộ lesson_cards/quiz_items nháp (GENERATED_DRAFT, REVIEWING, CHANGES_REQUESTED) có source_chunk_ids chạm chunk của tài liệu bằng bộ này — danh sách rỗng nghĩa là xoá nháp — và gắn mỗi thẻ/câu vào lesson của LO có độ tin cao nhất của primary_chunk_id (không có LO thì bỏ, như trước). Một kết quả cho mỗi lượt xử lý: result_id = ENRICHMENT_CONTENT_RESULT.<document_id>.g<processing_generation>; core-api chỉ áp dụng khi processing_generation = documents.processing_generation và lượt đó chưa được áp dụng (documents.enrichment_generation), trong một transaction. concepts/chunk_concepts không đi qua đây: worker tự ghi cùng sự kiện outbox CONCEPT_GRAPH_PROJECT.",
  "type": "object",
  "allOf": [
    {
      "$ref": "worker-result-envelope.json"
    }
  ],
  "properties": {
    "kind": {
      "const": "ENRICHMENT_CONTENT_RESULT"
    },
    "payload": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "processing_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "lesson_cards": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "properties": {
              "card_id": {
                "type": "string",
                "format": "uuid"
              },
              "primary_chunk_id": {
                "type": "string",
                "format": "uuid"
              },
              "source_chunk_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 200
              },
              "heading_path": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 50
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 10
              },
              "key_insight": {
                "type": "string",
                "minLength": 1
              },
              "card_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "card_id",
              "primary_chunk_id",
              "source_chunk_ids",
              "heading_path",
              "title",
              "bullets",
              "key_insight",
              "card_index"
            ],
            "additionalProperties": false
          }
        },
        "quiz_items": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "description": "Câu MCQ_SINGLE; correct_index < số lựa chọn (core-api kiểm). Đáp án lưu thành chuỗi lựa chọn đúng.",
            "properties": {
              "quiz_id": {
                "type": "string",
                "format": "uuid"
              },
              "primary_chunk_id": {
                "type": "string",
                "format": "uuid"
              },
              "source_chunk_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 200
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 10
              },
              "correct_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "quiz_id",
              "primary_chunk_id",
              "source_chunk_ids",
              "question",
              "choices",
              "correct_index",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "document_id",
        "processing_generation",
        "model_id",
        "lesson_cards",
        "quiz_items"
      ],
      "additionalProperties": false
    }
  }
}
