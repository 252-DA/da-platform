{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://da-platform.dev/contracts/integration-events/v1/essay-grading-requested.json",
  "title": "ESSAY_GRADING_REQUESTED",
  "description": "Core command → answer-grading worker (queue: essay_grading, worker/runners/answer_grading_worker.py). Phát khi core-api đã tải file của một bài luận sinh viên nộp vào Assignment Canvas có gắn công cụ làm Asset Processor (core-api essay-processor/essay-report.publisher.ts): essay_submissions.status = QUEUED. Lệnh tự chứa: đề, rubric, điểm tối đa (snapshot essay_processors lúc giao) và khoá MinIO của từng file; worker chỉ đọc file từ object storage, không đọc essay_submissions/essay_processors. Worker trả ESSAY_GRADING_RESULT (essay-grading-result.json); core-api chuyển GRADED hoặc FAILED rồi gửi báo cáo về SpeedGrader. Worker không gọi LMS. Sự kiện cũ chỉ có essay_submission_id/course_id: worker trả FAILED (PROCESSING_FAILED) để giảng viên chấm tay.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.json" }],
  "properties": {
    "event_type": { "const": "ESSAY_GRADING_REQUESTED" },
    "aggregate_type": { "const": "essay_submission" },
    "payload": {
      "type": "object",
      "properties": {
        "essay_submission_id": { "type": "string", "format": "uuid" },
        "course_id": { "type": "string", "format": "uuid" },
        "user_id": {
          "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }],
          "description": "essay_submissions.user_id; chỉ để ghi llm_usage_logs."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "instructions": { "type": "string", "maxLength": 10000 },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "points": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
            },
            "required": ["criterion", "description", "points"],
            "additionalProperties": false
          }
        },
        "max_score": { "type": "number", "exclusiveMinimum": 0 },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "asset_id": { "type": "string", "minLength": 1 },
              "title": { "type": ["string", "null"] },
              "content_type": { "type": ["string", "null"] },
              "storage_key": { "type": "string", "minLength": 1, "description": "Khoá object trong MinIO, core-api đã tải file về." }
            },
            "required": ["asset_id", "title", "content_type", "storage_key"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "essay_submission_id",
        "course_id",
        "user_id",
        "title",
        "instructions",
        "rubric",
        "max_score",
        "assets"
      ],
      "additionalProperties": false
    }
  }
}
