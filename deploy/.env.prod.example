# Mẫu cho .env.prod trên VM (chmod 600, KHÔNG commit file thật). Bản gốc giữ
# trong Infisical env `prod`; khi đổi thì export lại ra file. Compose báo lỗi nếu
# thiếu biến bắt buộc.
#
# Mật khẩu: hex 32 ký tự (openssl rand -hex 16) để nhúng vào URL/DSN không lỗi.
# Mỗi môi trường một bộ riêng, không dùng lại mật khẩu dev.

# ── Phiên bản image ──
# deploy/deploy.sh <tag> tự ghi lại dòng này. Tag = SHA của meta-repo.
IMAGE_TAG=

# ── Postgres (tài khoản quản trị: chỉ migrate và db-roles dùng) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chunking
# Mật khẩu 3 role của từng service (deploy/postgres/roles.sql)
LMS_CORE_APP_PASSWORD=
LMS_AI_WORKER_PASSWORD=
LMS_MCP_READER_PASSWORD=

# ── Kho dữ liệu khác ──
REDIS_PASSWORD=
QDRANT_API_KEY=
NEO4J_PASSWORD=

# ── Object storage: Cloudflare R2 (tên biến giữ MINIO__* vì code đọc tên đó) ──
# Endpoint không có https:// và không có bucket. Token R2 gắn một bucket,
# quyền Object Read & Write. Bucket tạo sẵn trên dashboard, kèm CORS cho
# https://<domain của tool> (PUT, header Content-Type) để trình duyệt tải lên
# thẳng bằng presigned URL.
MINIO__ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO__ACCESS_KEY=
MINIO__SECRET_KEY=
MINIO__BUCKET_NAME=documents
MINIO__SECURE=true
MINIO__REGION=auto

# ── Cloudflare Tunnel (token của tunnel da-prod) ──
TUNNEL_TOKEN=

# ── Thư mục chứa khóa (lti.pem, lti.pub.pem, bff-to-core.pem, bff-to-core.pub.pem) ──
# Tính từ thư mục deploy/. Để trống thì dùng <repo>/keys.
# KEYS_DIR=../keys

# ── Canvas ──
CANVAS_PUBLIC_URL=https://canvas.example.com
CANVAS_API_URL=
CANVAS_API_TOKEN=
# Hai tác vụ nền này chỉ prod mới bật.
AGS_ENABLED=true
CANVAS_AUTO_SYNC_ENABLED=true

# ── LTI (phía tool). Lấy đúng như .env hiện tại nếu prod nhận lại hostname cũ ──
LTI_LMS_TYPE=canvas
LTI_PLATFORM_URL=https://canvas.example.com
LTI_ISSUER_URL=
LTI_AUTH_URL=
LTI_JWKS_URL=
LTI_TOKEN_URL=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_KEY_ID=
LTI_REDIRECT_URI=https://app.example.com/lti/launch
LTI_EXTRA_CLIENT_IDS=
LTI_EXTRA_DEPLOYMENT_IDS=
LTI_COOKIE_SAMESITE=lax
LTI_COOKIE_SECURE=true
# Production từ chối khóa RSA < 2048 bit của Canvas. Canvas dev đang dùng khóa mẫu
# 512 bit nên launch sẽ lỗi; true là chấp nhận id_token giả mạo được. Chỉ bật tạm
# cho tới khi Canvas thay khóa.
LTI_ALLOW_WEAK_RSA_VERIFICATION=false

# ── Embedding: phải giống dev, nếu không vector khác không gian với dữ liệu đã index ──
EMBEDDING_BACKEND=openai
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
EMBEDDING_API_DIMENSIONS=

# ── LLM: key riêng cho prod, đặt hạn mức chi tiêu, không dùng Gemini free tier ──
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Để trống thì dùng mặc định của catalog (docs/model-routing-design.md)
LLM_PROFILE=
LLM_PROFILE__ENRICHMENT=
LLM_PROFILE__TUTOR=gemini-flash-lite
LLM_PROFILE__QUIZ_GENERATION=
LLM_PROFILE__QUIZ_VERIFICATION=
LLM_PROFILE__QUIZ_REGENERATION=
