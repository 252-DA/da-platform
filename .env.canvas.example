# Copy to `.env` on the DA/chunking machine when Canvas LMS is the platform.
#
# For Instructure-hosted Canvas, CANVAS_PUBLIC_URL is usually the school account
# domain, while LTI_ISSUER_URL remains https://canvas.instructure.com.
# For self-hosted Canvas, set CANVAS_PUBLIC_URL and LTI_ISSUER_URL to your
# Canvas host, then point LTI_AUTH_URL/LTI_JWKS_URL at that same host.

DA_PUBLIC_URL=https://DA_PUBLIC_HOST
CANVAS_PUBLIC_URL=https://SCHOOL.instructure.com

# Next.js LTI tool config for Canvas LMS as the LTI 1.3 platform.
LTI_LMS_TYPE=canvas
LTI_PLATFORM_URL=https://SCHOOL.instructure.com
LTI_ISSUER_URL=https://canvas.instructure.com
LTI_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
LTI_JWKS_URL=https://sso.canvaslms.com/api/lti/security/jwks
LTI_TOKEN_URL=https://SCHOOL.instructure.com/login/oauth2/token
LTI_REDIRECT_URI=https://DA_PUBLIC_HOST/lti/launch
LTI_CLIENT_ID=PASTE_CLIENT_ID_FROM_CANVAS
LTI_DEPLOYMENT_ID=
LTI_KEY_ID=ai-nextjs-1

# Canvas normally launches tools in an iframe. Use SameSite=None only with HTTPS.
# For local HTTP testing, keep lax/false and configure Canvas to open the tool
# in a new tab/window.
LTI_COOKIE_SAMESITE=none
LTI_COOKIE_SECURE=true

# Internal DA compose service names. Leave these as-is when running web inside
# this docker-compose project.
GRPC_HOST=grpc-server:50051
NEXT_PUBLIC_BACKEND_URL=http://http-api:8000

# Required by docker-compose.yml for LLM-backed quiz/enrichment flows.
GEMINI_API_KEY=
